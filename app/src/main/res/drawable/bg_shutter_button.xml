<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ring -->
    <item>
        <shape android:shape="oval">
            <size android:width="76dp" android:height="76dp" />
            <stroke android:width="4dp" android:color="@color/shutter_ring" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- Inner filled shutter -->
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="@color/shutter_inner" />
        </shape>
    </item>
</layer-list>
